{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "navy", "color": "#122056", "name": "Brand Navy" },
				{ "slug": "navy-deep", "color": "#0A1338", "name": "Deep Navy" },
				{ "slug": "indigo", "color": "#5B65DC", "name": "Brand Indigo" },
				{ "slug": "indigo-light", "color": "#7B85FE", "name": "Indigo Light" },
				{ "slug": "tint", "color": "#EEEEFD", "name": "Accent Tint" },
				{ "slug": "canvas", "color": "#FAFAFD", "name": "Canvas" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" },
				{ "slug": "ink", "color": "#121C28", "name": "Ink" },
				{ "slug": "muted", "color": "#4B5563", "name": "Muted Text" },
				{ "slug": "border", "color": "#E0E4F6", "name": "Border" },
				{ "slug": "emerald", "color": "#10B981", "name": "Emerald Success" },
				{ "slug": "emerald-deep", "color": "#0B7A55", "name": "Emerald Deep" },
				{ "slug": "danger", "color": "#B42318", "name": "Danger" }
			],
			"gradients": [
				{ "slug": "hero", "name": "Hero Navy", "gradient": "linear-gradient(135deg, #122056 0%, #1B2A6B 55%, #5B65DC 100%)" },
				{ "slug": "hero-deep", "name": "Hero Deep", "gradient": "linear-gradient(160deg, #0A1338 0%, #122056 60%, #26347E 100%)" },
				{ "slug": "metric-pill", "name": "Metric Pill", "gradient": "linear-gradient(135deg, #EEEEFD 0%, #FFFFFF 100%)" },
				{ "slug": "indigo", "name": "Indigo Sweep", "gradient": "linear-gradient(135deg, #5B65DC 0%, #7B85FE 100%)" },
				{ "slug": "tint-fade", "name": "Tint Fade", "gradient": "linear-gradient(180deg, #EEEEFD 0%, #FFFFFF 100%)" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"name": "Plus Jakarta Sans",
					"slug": "jakarta",
					"fontFamily": "\"Plus Jakarta Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Plus Jakarta Sans",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/plus-jakarta-sans-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Plus Jakarta Sans",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/plus-jakarta-sans-latin-ext.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"name": "Inter",
					"slug": "inter",
					"fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin-ext.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "display-lg", "name": "Display Large", "size": "clamp(2rem, 1.15rem + 3.1vw, 3rem)", "fluid": false },
				{ "slug": "headline-xl", "name": "Headline XL", "size": "clamp(1.625rem, 1.15rem + 2.1vw, 2.25rem)", "fluid": false },
				{ "slug": "headline-lg", "name": "Headline Large", "size": "clamp(1.375rem, 1.1rem + 1.2vw, 1.75rem)", "fluid": false },
				{ "slug": "headline-md", "name": "Headline Medium", "size": "clamp(1.25rem, 1.15rem + 0.5vw, 1.375rem)", "fluid": false },
				{ "slug": "headline-sm", "name": "Headline Small", "size": "clamp(1.0625rem, 1rem + 0.35vw, 1.125rem)", "fluid": false },
				{ "slug": "body-lg", "name": "Body Large", "size": "1rem", "fluid": false },
				{ "slug": "body-md", "name": "Body Medium", "size": "0.875rem", "fluid": false },
				{ "slug": "body-sm", "name": "Body Small", "size": "0.8125rem", "fluid": false },
				{ "slug": "label-lg", "name": "Label Large", "size": "0.875rem", "fluid": false },
				{ "slug": "label-md", "name": "Label Medium", "size": "0.75rem", "fluid": false },
				{ "slug": "label-sm", "name": "Label Small", "size": "0.6875rem", "fluid": false },
				{ "slug": "data-metric", "name": "Data Metric", "size": "clamp(1.5rem, 1.2rem + 1.1vw, 1.875rem)", "fluid": false }
			]
		},
		"spacing": {
			"units": [ "%", "px", "em", "rem", "vh", "vw" ]
		},
		"custom": {
			"radius": {
				"sm": "0.25rem",
				"base": "0.5rem",
				"md": "0.75rem",
				"lg": "1rem",
				"xl": "1.5rem",
				"pill": "9999px"
			},
			"shadow": {
				"card": "0 1px 3px 0 rgba(18, 32, 86, 0.04), 0 1px 2px -1px rgba(18, 32, 86, 0.04)",
				"hover": "0 10px 15px -3px rgba(18, 32, 86, 0.06), 0 4px 6px -4px rgba(18, 32, 86, 0.03)",
				"float": "0 20px 25px -5px rgba(18, 32, 86, 0.1), 0 8px 10px -6px rgba(18, 32, 86, 0.04)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|canvas",
			"text": "var:preset|color|ink"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|inter",
			"fontSize": "var:preset|font-size|body-lg",
			"fontWeight": "400",
			"lineHeight": "1.65",
			"letterSpacing": "-0.005em"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": { "left": "0", "right": "0" }
		},
		"elements": {
			"heading": {
				"color": { "text": "var:preset|color|navy" },
				"typography": {
					"fontFamily": "var:preset|font-family|jakarta",
					"fontWeight": "700",
					"lineHeight": "1.16",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|display-lg" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|headline-xl" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|headline-lg" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|headline-md" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|headline-sm" } },
			"h6": { "typography": { "fontSize": "var:preset|font-size|label-md", "letterSpacing": "0.08em", "textTransform": "uppercase" } },
			"link": {
				"color": { "text": "var:preset|color|indigo" },
				"typography": { "textDecoration": "none" },
				":hover": { "color": { "text": "var:preset|color|navy" }, "typography": { "textDecoration": "underline" } }
			},
			"button": {
				"color": { "background": "var:preset|color|navy", "text": "var:preset|color|white" },
				"border": { "radius": "0.5rem", "width": "1px", "style": "solid", "color": "transparent" },
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" } },
				"typography": {
					"fontFamily": "var:preset|font-family|jakarta",
					"fontWeight": "700",
					"fontSize": "var:preset|font-size|label-lg",
					"lineHeight": "1.3",
					"letterSpacing": "-0.005em",
					"textDecoration": "none"
				},
				":hover": { "color": { "background": "var:preset|color|indigo", "text": "var:preset|color|white" } },
				":focus": { "outline": { "width": "3px", "style": "solid", "color": "rgba(91, 101, 220, 0.35)" } }
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": { "background": "transparent", "text": "var:preset|color|navy" },
						"border": { "color": "var:preset|color|border", "width": "1px" },
						":hover": { "color": { "background": "var:preset|color|canvas", "text": "var:preset|color|navy" }, "border": { "color": "var:preset|color|indigo" } }
					}
				}
			},
			"core/details": {
				"border": { "color": "var:preset|color|border", "width": "1px", "radius": "0.75rem" },
				"color": { "background": "var:preset|color|white", "text": "var:preset|color|ink" },
				"spacing": { "padding": { "top": "1.125rem", "bottom": "1.125rem", "left": "1.375rem", "right": "1.375rem" } }
			},
			"core/columns": {
				"spacing": { "blockGap": { "top": "1.5rem", "left": "1.5rem" } }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|border" }
			},
			"core/navigation": {
				"typography": { "fontFamily": "var:preset|font-family|jakarta", "fontWeight": "600", "fontSize": "var:preset|font-size|body-md" },
				"elements": { "link": { "color": { "text": "var:preset|color|ink" }, "typography": { "textDecoration": "none" }, ":hover": { "color": { "text": "var:preset|color|indigo" }, "typography": { "textDecoration": "none" } } } }
			},
			"core/post-title": {
				"typography": { "fontFamily": "var:preset|font-family|jakarta", "fontWeight": "700" }
			}
		}
	}
}
