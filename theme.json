{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"palette": [
				{
					"slug": "surface",
					"color": "#f8f9ff",
					"name": "Surface"
				},
				{
					"slug": "surface-container-low",
					"color": "#eef4ff",
					"name": "Surface Container Low"
				},
				{
					"slug": "surface-container-lowest",
					"color": "#ffffff",
					"name": "Surface Container Lowest"
				},
				{
					"slug": "on-surface",
					"color": "#121c28",
					"name": "On Surface"
				},
				{
					"slug": "on-surface-variant",
					"color": "#45464f",
					"name": "On Surface Variant"
				},
				{
					"slug": "primary",
					"color": "#000a39",
					"name": "Primary"
				},
				{
					"slug": "primary-container",
					"color": "#122056",
					"name": "Primary Container"
				},
				{
					"slug": "secondary",
					"color": "#4750c7",
					"name": "Secondary"
				},
				{
					"slug": "secondary-fixed",
					"color": "#e0e0ff",
					"name": "Secondary Fixed"
				},
				{
					"slug": "tertiary-fixed",
					"color": "#6ffbbe",
					"name": "Tertiary Fixed"
				}
			]
		},
		"typography": {
			"fluid": false,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"name": "Plus Jakarta Sans",
					"slug": "jakarta",
					"fontFamily": "\"Plus Jakarta Sans\", ui-sans-serif, system-ui, sans-serif"
				},
				{
					"name": "Inter",
					"slug": "inter",
					"fontFamily": "Inter, ui-sans-serif, system-ui, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "body-md",
					"name": "Body Medium",
					"size": "14px"
				},
				{
					"slug": "body-lg",
					"name": "Body Large",
					"size": "16px"
				},
				{
					"slug": "headline-xl",
					"name": "Headline XL",
					"size": "36px"
				},
				{
					"slug": "display-lg",
					"name": "Display Large",
					"size": "48px"
				},
				{
					"slug": "data-metric",
					"name": "Data Metric",
					"size": "30px"
				}
			]
		},
		"spacing": {
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			],
			"defaultSpacingSizes": false
		},
		"layout": {
			"contentSize": "100%",
			"wideSize": "1440px"
		}
	},
	"styles": {
		"color": {
			"background": "transparent",
			"text": "#121c28"
		},
		"spacing": {
			"blockGap": "0",
			"padding": {
				"left": "0",
				"right": "0"
			}
		},
		"elements": {
			"link": {
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			}
		}
	}
}